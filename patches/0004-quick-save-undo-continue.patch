+#ifdef __EMSCRIPTEN__
+/*
+ * Web/phone build helpers, called from the page (see os/emscripten and the
+ * page's JavaScript):
+ *  - quick save when the app is sent to the background,
+ *  - "Back": a few in-memory snapshots taken just before the player's own
+ *    actions, restored by loading them,
+ *  - load a savegame by path (for the "Continue" button).
+ * Snapshots live in /tmp, which is memory only and never persisted.
+ */
+static std::deque<std::string> _web_undo_stack; ///< Snapshot files, oldest first.
+static uint _web_undo_counter = 0;              ///< For unique snapshot file names.
+static std::chrono::steady_clock::time_point _web_last_snapshot{};
+static bool _web_snapshot_pending = false;      ///< A snapshot was just taken for the command being executed.
+static bool _web_undo_loading = false;          ///< We are loading a snapshot (keep the stack).
+static std::string _web_undo_saved_name;        ///< _file_to_saveload.name to restore after an undo.
+static EncodedString _web_undo_saved_title;     ///< _file_to_saveload.title to restore after an undo.
+static constexpr size_t WEB_UNDO_STEPS = 5;     ///< How many actions can be undone.
+static constexpr auto WEB_UNDO_MERGE = std::chrono::milliseconds(500); ///< Actions closer together than this are one step.
+
+static void WebUndoNotify()
+{
+	EM_ASM({ if (window["openttd_undo_changed"]) openttd_undo_changed($0); }, (int)_web_undo_stack.size());
+}
+
+static void WebUndoClear()
+{
+	for (const auto &f : _web_undo_stack) FioRemove(f);
+	_web_undo_stack.clear();
+	_web_snapshot_pending = false;
+	WebUndoNotify();
+}
+
+/** Called just before the local player's command is executed. */
+void WebUndoBeforeCommand(Commands cmd)
+{
+	_web_snapshot_pending = false;
+	if (_game_mode != GM_NORMAL || _networking || _web_undo_loading || cmd == CMD_PAUSE) return;
+
+	auto now = std::chrono::steady_clock::now();
+	if (!_web_undo_stack.empty() && now - _web_last_snapshot < WEB_UNDO_MERGE) {
+		_web_last_snapshot = now; // part of the same step (e.g. a drag that issues several commands)
+		return;
+	}
+
+	std::string path = fmt::format("/tmp/undo-{}.sav", _web_undo_counter++);
+	std::string format = _savegame_format;
+	_savegame_format = "none"; // fastest; these never leave memory
+	SaveOrLoadResult res = SaveOrLoad(path, SLO_SAVE, DFT_GAME_FILE, NO_DIRECTORY, false);
+	_savegame_format = format;
+	if (res != SL_OK) return;
+
+	_web_undo_stack.push_back(path);
+	while (_web_undo_stack.size() > WEB_UNDO_STEPS) {
+		FioRemove(_web_undo_stack.front());
+		_web_undo_stack.pop_front();
+	}
+	_web_last_snapshot = now;
+	_web_snapshot_pending = true;
+	WebUndoNotify();
+}
+
+/** Called after that command ran; a failed command should not use up an undo step. */
+void WebUndoCommandResult(bool succeeded)
+{
+	if (!_web_snapshot_pending) return;
+	_web_snapshot_pending = false;
+	if (succeeded || _web_undo_stack.empty()) return;
+	FioRemove(_web_undo_stack.back());
+	_web_undo_stack.pop_back();
+	_web_last_snapshot = {};
+	WebUndoNotify();
+}
+
+/** Called once a snapshot has been loaded (or failed to load). */
+static void WebUndoAfterLoad()
+{
+	FioRemove(_file_to_saveload.name);
+	_file_to_saveload.name = _web_undo_saved_name;
+	_file_to_saveload.title = _web_undo_saved_title;
+	_web_undo_loading = false;
+	WebUndoNotify();
+}
+
+extern "C" {
+
+/** Save the running game now (app going to the background). @return 1 on success. */
+int CDECL em_openttd_quicksave()
+{
+	if (_game_mode != GM_NORMAL || _networking || _switch_mode != SM_NONE) return 0;
+	return SaveOrLoad("phone-quicksave.sav", SLO_SAVE, DFT_GAME_FILE, AUTOSAVE_DIR, false) == SL_OK ? 1 : 0;
+}
+
+/** Undo the last action. @return steps left, or -1 if there was nothing to undo. */
+int CDECL em_openttd_undo()
+{
+	if (_game_mode != GM_NORMAL || _web_undo_stack.empty() || _switch_mode != SM_NONE) return -1;
+	std::string path = _web_undo_stack.back();
+	_web_undo_stack.pop_back();
+	_web_undo_saved_name = _file_to_saveload.name;
+	_web_undo_saved_title = _file_to_saveload.title;
+	_file_to_saveload.SetMode(FIOS_TYPE_FILE, SLO_LOAD);
+	_file_to_saveload.name = path;
+	_web_undo_loading = true;
+	_switch_mode = SM_LOAD_GAME;
+	return (int)_web_undo_stack.size();
+}
+
+/** Trees, town buildings and industries that "see-through" toggles together. */
+static constexpr TransparencyOption WEB_SEE_THROUGH[] = { TO_TREES, TO_HOUSES, TO_INDUSTRIES };
+
+/** Is the see-through view on (any of its parts)? */
+int CDECL em_openttd_see_through_state()
+{
+	for (TransparencyOption to : WEB_SEE_THROUGH) if (HasBit(_transparency_opt, to)) return 1;
+	return 0;
+}
+
+/** Toggle trees and buildings see-through in one go. @return 1 when now see-through. */
+int CDECL em_openttd_toggle_see_through()
+{
+	bool on = em_openttd_see_through_state() == 0;
+	for (TransparencyOption to : WEB_SEE_THROUGH) {
+		if (on) SetBit(_transparency_opt, to); else ClrBit(_transparency_opt, to);
+	}
+	MarkWholeScreenDirty();
+	InvalidateWindowClassesData(WC_TRANSPARENCY_TOOLBAR); // keep the game's own transparency bar in step
+	return on ? 1 : 0;
+}
+
+/** How many actions can be undone. */
+int CDECL em_openttd_undo_count()
+{
+	return (int)_web_undo_stack.size();
+}
+
+/** Load a savegame by its full path (the "Continue" button). */
+void CDECL em_openttd_load_game(const char *path)
+{
+	if (_switch_mode != SM_NONE) return;
+	_file_to_saveload.SetMode(FIOS_TYPE_FILE, SLO_LOAD);
+	_file_to_saveload.name = path;
+	_file_to_saveload.title = {};
+	_switch_mode = SM_LOAD_GAME;
+}
+
+}
